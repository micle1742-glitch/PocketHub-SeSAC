# PostgreSQL 접속 정보 (값은 각자 .env 또는 실행 환경변수에 넣고, 이 파일엔 이름만)
# DB_URL 형식: jdbc:postgresql://<호스트>:<포트>/<DB이름>  (아래는 가짜 예시)
DB_URL=jdbc:postgresql://db.example.com:5432/pockethub
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=

# 파일 저장소: local | supabase (비우면 아래 SUPABASE_* 세 값이 모두 있을 때 supabase, 아니면 로컬 디스크)
STORAGE_TYPE=
# Supabase Storage (비공개 버킷). 형식: SUPABASE_URL=https://<프로젝트>.supabase.co
SUPABASE_URL=
# service_role 키: 서버에서만 사용, 프론트·커밋·로그에 절대 넣지 않는다
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
