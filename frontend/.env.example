# true: 목업 데이터(브라우저 안 가짜 서버)로 동작 / false: 실제 백엔드 호출
NEXT_PUBLIC_USE_MOCK=true
# 실제 백엔드 주소 (NEXT_PUBLIC_USE_MOCK=false 일 때 사용). 비우면 같은 도메인(/api/v1/...)으로 요청
# 기본은 비워 둔다: 아래 API_PROXY_TARGET 프록시를 쓰면 같은 도메인으로 요청해야 하기 때문
NEXT_PUBLIC_API_URL=
# 프록시 대상 백엔드 주소 (예: https://api.example.com, 끝에 / 없이)
# 값이 있으면 next.config.mjs 가 /api/:path* 요청을 이 주소의 /api/:path* 로 넘긴다. 비우면 프록시를 쓰지 않음
# NEXT_PUBLIC_ 이 아니므로 브라우저에 노출되지 않는다
API_PROXY_TARGET=
